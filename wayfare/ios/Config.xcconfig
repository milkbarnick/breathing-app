// Wayfare build configuration (used by both Debug and Release).
//
// IMPORTANT: in .xcconfig files "//" starts a comment, so writing
//     API_BASE_URL = https://wayfare-api.example.workers.dev
// would silently become "https:". The "$()" below expands to nothing and splits
// the two slashes, so the final value is "https://wayfare-api.example.workers.dev".
// Keep that trick when you put in your real Worker URL (no trailing slash):
//     API_BASE_URL = https:/$()/wayfare-api.<your-subdomain>.workers.dev
API_BASE_URL = https:/$()/wayfare-api.example.workers.dev

// Your Apple Developer Team ID (10 characters, e.g. AB12CD34EF). Find it at
// https://developer.apple.com/account -> Membership details. You can also leave
// it empty and pick your team in Xcode (target Wayfare -> Signing & Capabilities).
DEVELOPMENT_TEAM =

// Shown in the App Store / TestFlight. Bump CURRENT_PROJECT_VERSION for every upload.
MARKETING_VERSION = 1.0.0
CURRENT_PROJECT_VERSION = 1

// Optional, git-ignored per-machine overrides (for example your own team ID).
#include? "Config.local.xcconfig"
